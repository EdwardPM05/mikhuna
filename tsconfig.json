{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // supabase/functions/_shared (compartido con Deno) importa con extensión .ts.
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", "nativewind-env.d.ts"],
  "exclude": ["node_modules", "supabase/functions", "scripts/pruebas"]
}
