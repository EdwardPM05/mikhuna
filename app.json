{
  "expo": {
    "name": "Mikhuna",
    "slug": "mikhuna-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./src/assets/images/logo_icon.png",
    "scheme": "mikhuna",
    "runtimeVersion": "0.1.0",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mikhuna.app",
      "userInterfaceStyle": "light"
    },
    "android": {
      "userInterfaceStyle": "light",
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/logo_icon_foreground.png",
        "backgroundColor": "#FDF3E7"
      },
      "package": "com.mikhuna.app",
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./src/assets/images/logo_splash_padded.png",
          "backgroundColor": "#FDF3E7",
          "resizeMode": "contain",
          "imageWidth": 320
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Mikhuna usa tu ubicación para mostrarte negocios afiliados cerca de ti."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "router": {}
    }
  }
}
